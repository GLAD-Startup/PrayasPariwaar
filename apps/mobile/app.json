{
  "expo": {
    "name": "Prayas Sanstha",
    "slug": "prayas-sanstha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "prayas",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D4ED8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.prayassanstha.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Prayas needs camera access so you can capture profile photos and document seva drives.",
        "NSPhotoLibraryUsageDescription": "Prayas needs access to your photo gallery to upload profile avatars and project images.",
        "NSPhotoLibraryAddUsageDescription": "Prayas needs permission to save donation receipts and certificates to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1D4ED8"
      },
      "package": "org.prayassanstha.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1D4ED8"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Prayas to access your photo library to select and upload your profile picture.",
          "cameraPermission": "Allow Prayas to use your camera to take a new profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "c14d5e45-50f8-43f9-bd25-2a77cbd2aee5"
      },
      "router": {
        "origin": false
      }
    },
    "owner": "glad-studio"
  }
}
