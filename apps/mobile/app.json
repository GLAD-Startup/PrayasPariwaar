{
  "expo": {
    "name": "Prayas Sanstha",
    "slug": "prayas-sanstha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "prayas",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.prayassanstha.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Prayas needs camera access so you can capture profile photos and document seva drives.",
        "NSPhotoLibraryUsageDescription": "Prayas needs access to your photo gallery to upload profile avatars and project images.",
        "NSPhotoLibraryAddUsageDescription": "Prayas needs permission to save donation receipts and certificates to your photo library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "org.prayassanstha.mobile",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.NOTIFICATIONS",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#166534"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Prayas to access your photo library to select and upload your profile picture.",
          "cameraPermission": "Allow Prayas to use your camera to take a new profile photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "66f258a6-f402-4575-b058-9ddc1c228d80"
      }
    },
    "owner": "arjun2k4"
  }
}
