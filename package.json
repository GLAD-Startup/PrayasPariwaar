{
  "name": "prayas-platform",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "description": "Prayas Sanstha NGO Platform - Monorepo for Web (Next.js), Mobile (Expo React Native), and Database (Prisma)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "db:generate": "npm run db:generate --workspace=@prayas/database",
    "db:push": "npm run db:push --workspace=@prayas/database",
    "db:seed": "npm run db:seed --workspace=@prayas/database",
    "db:migrate": "npm run db:migrate --workspace=@prayas/database",
    "db:studio": "npm run db:studio --workspace=@prayas/database",
    "postinstall": "npm run db:generate",
    "web:dev": "npm run dev --workspace=@prayas/web",
    "web:build": "npm run build --workspace=@prayas/web",
    "web:start": "npm run start --workspace=@prayas/web",
    "mobile:dev": "npm run dev --workspace=@prayas/mobile"
  },
  "devDependencies": {
    "expo": "~52.0.37",
    "prettier": "^3.3.3",
    "react-native": "0.76.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.1.1",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9"
  },
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  }
} 