# -----------------------------------------------------------------------------
# Prayas Platform Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL Database Connection (Self-Hosted / VPS / Render / Railway / Supabase-free)
DATABASE_URL="postgresql://postgres:password@localhost:5432/prayas_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET="your-super-secret-jwt-access-token-key-change-in-production-32-chars-min"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-token-key-change-in-production-32-chars-min"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

# Razorpay Payment Gateway (for /donate and webhook)
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"

# Expo Push Notifications
# (Optional Expo Access Token if your Expo project requires enhanced security)
EXPO_ACCESS_TOKEN=""

# Public API & Web URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000/api"
EXPO_PUBLIC_API_URL="http://localhost:3000/api"

# File Storage (Cloudflare R2 or AWS S3)
S3_BUCKET_NAME="prayas-assets"
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
